# PayPal Sandbox Credentials (Required)
# Create a REST API app in PayPal Developer Dashboard -> Apps & Credentials (Sandbox)
PAYPAL_CLIENT_ID=sandbox_client_id_placeholder
PAYPAL_CLIENT_SECRET=sandbox_client_secret_placeholder
PAYPAL_SANDBOX_BASE_URL=https://api-m.sandbox.paypal.com

# Sandbox Buyer Email (Display hint in terminal approval prompt; must be a US Personal sandbox account for USD orders)
PAYPAL_SANDBOX_BUYER_EMAIL=sb-buyer@personal.example.com

# Optional: PayPal Webhook ID (Only needed if testing stretch /webhooks/paypal signature verification)
PAYPAL_WEBHOOK_ID=sandbox_webhook_id_placeholder

# Database Configuration (Default: zero-config local SQLite at backend/trustrail.db)
# Leave DATABASE_URL unset to automatically use the unified absolute path backend/trustrail.db.
# Avoid relative sqlite paths like ./trustrail.db if launching uvicorn/scripts from different directories.
# PostgreSQL / Docker alternative:
# DATABASE_URL=postgresql+asyncpg://trustrail:trustrail@localhost:5432/trustrail

# LLM Configuration (Optional - uses deterministic agent reasoning if unset/placeholder)
OPENAI_API_KEY=your_llm_api_key_here
LLM_MODEL=gpt-4o-mini

# Backend Service & ML Artifacts (Resolved relative to backend/ regardless of launch directory)
BACKEND_URL=http://localhost:8000
RISK_MODEL_PATH=./ml/model.json
RISK_THRESHOLD_PATH=./ml/threshold.json

# Demo Scenario Tuning
SCENARIO_B_ITERATIONS=3

# Dashboard
VITE_API_BASE_URL=http://localhost:8000
